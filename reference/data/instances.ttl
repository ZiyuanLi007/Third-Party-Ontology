        e:O-01-passage ;
    f:from e:O-01 ;
    f:rationale "Target explicitly addresses classification. Timing is assessed separately from the text, not inferred from topic similarity." ;
    f:relationship "addressedBy" ;
    f:review "unreviewed" ;
    f:scenario e:A ;
    f:supportedElement "before_contract",
        "classification" ;
    f:to e:A-PolicyRequirement .

