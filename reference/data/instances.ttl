e:DORA-OJ-2022 a f:SourceDocumentVersion ;
    f:url "https://eur-lex.europa.eu/eli/reg/2022/2554/oj/eng" ;
    f:version "Original OJ 2022" .

e:A-Control a f:Control ;
    f:evidence e:A-Control-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:A-Control-passage a f:SourcePassage ;
    f:locator "Control §1" ;
    f:source e:A-BANK-v1 ;
    f:text "Before signature, the approver checks that the critical-or-important-function classification is completed; missing classification blocks signature." .

e:B-Control a f:Control ;
    f:evidence e:B-Control-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:B-Control-passage a f:SourcePassage ;
    f:locator "Control §1" ;
    f:source e:B-BANK-v1 ;
    f:text "The reviewer checks that a critical-or-important-function classification is present." .

e:C a f:Scenario ;
    f:hasNode e:C-PolicyRequirement,
        e:C-ProcedureStep,
        e:O-01 ;
    f:scope "Synthetic EU ICT arrangement; applies for demonstration only" .

e:C-BANK-v1 a f:SourceDocumentVersion ;
    f:version "synthetic-v1" .

e:C-ProcedureStep a f:ProcedureStep ;
    f:evidence e:C-ProcedureStep-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:C-ProcedureStep-passage a f:SourcePassage ;
    f:locator "ProcedureStep §1" ;
    f:source e:C-BANK-v1 ;
    f:text "The service owner completes the critical-or-important-function classification and submits it before contract signature." .

e:D-Control a f:Control ;
    f:evidence e:D-Control-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:D-Control-passage a f:SourcePassage ;
    f:locator "Control §1" ;
    f:source e:D-BANK-v1 ;
    f:text "The classification check is performed only after contract signature; there is no pre-signature check." .

e:A a f:Scenario ;
    f:hasNode e:A-Control,
        e:A-PolicyRequirement,
        e:A-ProcedureStep,
        e:O-01 ;
    f:scope "Synthetic EU ICT arrangement; applies for demonstration only" .

e:A-BANK-v1 a f:SourceDocumentVersion ;
    f:version "synthetic-v1" .

e:A-PolicyRequirement a f:PolicyRequirement ;
    f:evidence e:A-PolicyRequirement-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:A-PolicyRequirement-passage a f:SourcePassage ;
    f:locator "PolicyRequirement §1" ;
    f:source e:A-BANK-v1 ;
    f:text "Before signing any ICT service contract, classify whether the service supports a critical or important function." .

e:A-ProcedureStep a f:ProcedureStep ;
    f:evidence e:A-ProcedureStep-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:A-ProcedureStep-passage a f:SourcePassage ;
    f:locator "ProcedureStep §1" ;
    f:source e:A-BANK-v1 ;
    f:text "The service owner completes the critical-or-important-function classification and submits it before contract signature." .

