e:B-ProcedureStep a f:ProcedureStep ;
    f:evidence e:B-ProcedureStep-passage ;
    f:review "unreviewed" ;
    f:synthetic true .

e:B-ProcedureStep-passage a f:SourcePassage ;
    f:locator "ProcedureStep §1" ;
    f:source e:B-BANK-v1 ;
    f:text "The service owner completes the critical-or-important-function classification and submits it before contract signature." .

