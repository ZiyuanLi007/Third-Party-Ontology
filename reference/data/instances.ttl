e:C-PolicyRequirement-passage a f:SourcePassage ;
    f:locator "PolicyRequirement §1" ;
    f:source e:C-BANK-v1 ;
    f:text "Before signing any ICT service contract, classify whether the service supports a critical or important function." .

e:D a f:Scenario ;
    f:hasNode e:D-Control,
        e:D-PolicyRequirement,
        e:D-ProcedureStep,
        e:O-01 ;
    f:scope "Synthetic EU ICT arrangement; applies for demonstration only" .

e:D-BANK-v1 a f:SourceDocumentVersion ;
    f:version "synthetic-v1" .

e:D-PolicyRequirement a f:PolicyRequirement ;
