    f:text "The service owner completes the critical-or-important-function classification and submits it before contract signature." .

e:O-01-passage a f:SourcePassage ;
    f:locator "Article 28(4)(a) + introductory sentence" ;
    f:source e:DORA-OJ-2022 ;
    f:text "assess whether the contractual arrangement covers the use of ICT services supporting a critical or important function;" .

e:O-01 a f:RegulatoryObligation ;
    f:bankInterpretation "SYNTHETIC DRAFT: the service owner records classification and obtains a pre-signature check. These roles and approvals are bank design choices, not quoted regulatory requirements." ;
    f:evidence e:O-01-passage ;
    f:plainEnglish "Before contracting for ICT services, assess whether they support a critical or important function." ;
    f:review "unreviewed" ;
    f:synthetic false .

